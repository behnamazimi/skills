{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jargon-gym-glossary",
  "title": "Jargon Gym glossary import",
  "description": "Import contract shared with jargon-gym-generator and jargon-gym-review. scripts/gym.mjs `validate output` enforces this plus the text rules in refs/rules.md (R-OUT).",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "description", "terms"],
  "properties": {
    "domain": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "category", "definition"],
        "properties": {
          "term": { "$ref": "#/$defs/text" },
          "category": { "$ref": "#/$defs/text" },
          "definition": { "$ref": "#/$defs/text" },
          "example": { "$ref": "#/$defs/text" },
          "mental_model": { "$ref": "#/$defs/text" },
          "discussion": { "$ref": "#/$defs/text" },
          "anti_example": { "$ref": "#/$defs/text" },
          "controversy": { "$ref": "#/$defs/text" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "relationship_type"],
        "properties": {
          "source": { "$ref": "#/$defs/text" },
          "target": { "$ref": "#/$defs/text" },
          "relationship_type": { "$ref": "#/$defs/text" },
          "description": { "$ref": "#/$defs/text" }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    }
  }
}
